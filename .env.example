# Sayt manzili (SEO, sitemap, Telegram havolalar uchun)
NEXT_PUBLIC_SITE_URL=https://mustafodev.uz

# Admin panel (/admin)
ADMIN_PASSWORD=kuchli-parol
# 32+ belgili tasodifiy satr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Firebase Admin (Firebase Console -> Project settings -> Service accounts -> Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Telegram (@BotFather dan token; botni kanalga admin qiling)
TELEGRAM_BOT_TOKEN=
# @kanal_nomi yoki -100... raqamli ID
TELEGRAM_CHANNEL_ID=@your_channel
# Tasodifiy satr (faqat A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=
# Sizning Telegram ID raqamingiz (@userinfobot dan bilib oling)
ADMIN_TELEGRAM_ID=

# Search Console tasdiqlash (ixtiyoriy)
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
